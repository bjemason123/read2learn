// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  goals        Goal[]
  tags         Tag[]
}

model Goal {
  id           String        @id @default(cuid())
  title        String
  description  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  readingItems ReadingItem[]
  questions    Question[]

  @@index([userId])
}

model Question {
  id        String   @id @default(cuid())
  text      String
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  goalId    String
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  notes     Note[]

  @@index([goalId, order])
}

enum Progress {
  NOT_STARTED
  IN_PROGRESS
  DONE
}

enum ItemType {
  BOOK
  PAPER
  ARTICLE
  OTHER
}

model ReadingItem {
  id        String   @id @default(cuid())
  title     String
  author    String?
  url       String?
  note      String?
  type      ItemType @default(OTHER)
  progress  Progress @default(NOT_STARTED)
  deferred  Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  goalId    String
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  notes     Note[]

  @@index([goalId, position])
}

model Note {
  id            String      @id @default(cuid())
  body          String
  location      String?
  order         Int
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  readingItemId String
  readingItem   ReadingItem @relation(fields: [readingItemId], references: [id], onDelete: Cascade)
  tags          Tag[]
  questions     Question[]

  @@index([readingItemId, order])
}

model Tag {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes     Note[]

  @@unique([userId, name])
}

model Event {
  id            String   @id @default(cuid())
  type          String
  goalId        String?
  readingItemId String?
  userId        String?
  createdAt     DateTime @default(now())
}
